@article{moulsdale_non-chiral_2024,
	title = {Non-chiral one-dimensional states inside {AB}/{BA} domain walls in bilayer graphene},
	volume = {1},
	issn = {3065-9736},
	url = {https://www.academia.edu/122329427/Non_chiral_one_dimensional_states_inside_AB_BA_domain_walls_in_bilayer_graphene},
	doi = {10.20935/AcadNano7267},
	abstract = {Boundaries between structural twins of bilayer graphene (so-called AB/BA domain walls (DWs)) are often discussed regarding the formation of topologically protected valley-polarized chiral states. Here, we show that, depending on the width of the AB/BA boundary, the latter can also support non-chiral one-dimensional (1D) states that are confined to the DW at low energies and take the form of quasi-bound states at higher energies, where the 1D bands cross into the two-dimensional spectral continuum. We present the results of modeling of the electronic properties of AB/BA DWs with and without magnetic field as a function of their width and interlayer bias.},
	language = {en},
	number = {1},
	urldate = {2026-04-23},
	journal = {Academia Nano: Science, Materials, Technology},
	author = {Moulsdale, Christian and Enaldiev, Vladimir V. and Geim, Andre K. and Fal’ko, Vladimir I.},
	month = jul,
	year = {2024},
	file = {PDF:pdfs/Moulsdale 等 - 2024 - Non-chiral one-dimensional states inside ABBA domain walls in bilayer graphene.pdf:application/pdf},
}

